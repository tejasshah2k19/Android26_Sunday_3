<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".diamondgame.GamePlayActivity"
    android:orientation="vertical"
    >


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:id="@+id/tvGamePlayCredit"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        android:text="CREDIT"
        android:layout_gravity="center"
        />

    <GridLayout
        android:layout_below="@id/tvGamePlayCredit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:rowCount="3"
        android:columnCount="3"

         >

        <ImageButton android:id="@+id/imgBtnGamePlayB1" android:layout_height="0dp" android:layout_width="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1"/>
        <ImageButton android:id="@+id/imgBtnGamePlayB2" android:layout_height="0dp" android:layout_width="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1"/>
        <ImageButton android:id="@+id/imgBtnGamePlayB3" android:layout_height="0dp" android:layout_width="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1"/>
        <ImageButton android:id="@+id/imgBtnGamePlayB4" android:layout_height="0dp" android:layout_width="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1"/>
        <ImageButton android:id="@+id/imgBtnGamePlayB5" android:layout_height="0dp" android:layout_width="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1"/>
        <ImageButton android:id="@+id/imgBtnGamePlayB6" android:layout_height="0dp" android:layout_width="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1"/>
        <ImageButton android:id="@+id/imgBtnGamePlayB7" android:layout_height="0dp" android:layout_width="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1"/>
        <ImageButton android:id="@+id/imgBtnGamePlayB8" android:layout_height="0dp" android:layout_width="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1"/>
        <ImageButton android:id="@+id/imgBtnGamePlayB9" android:layout_height="0dp" android:layout_width="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1"/>


    </GridLayout>
</LinearLayout>