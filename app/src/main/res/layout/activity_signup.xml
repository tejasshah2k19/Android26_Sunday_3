<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignupActivity"
    android:background="#BECCC9"
    >


    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:id="@+id/imgSignupLogo"
        android:src="@drawable/university"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        />

     <TextView
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:id="@+id/tvSignupTitle"
         android:text="Signup"
         android:textSize="15pt"
         android:layout_centerHorizontal="true"
         android:layout_marginTop="50dp"
         android:textColor="#0B0B0B"
         android:layout_below="@id/imgSignupLogo"
         />

     <EditText
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:id="@+id/edtSignupFirstName"
         android:layout_below="@id/tvSignupTitle"
         android:hint="Firstname"
         android:layout_marginTop="100dp"
         android:layout_marginStart="30dp"
         android:layout_marginEnd="30dp"
         />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/edtSignupEmail"
            android:layout_below="@id/edtSignupFirstName"
            android:hint="Email"
            android:layout_marginTop="20dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"

            />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/edtSignupPassword"
            android:layout_below="@id/edtSignupEmail"
            android:layout_marginTop="20dp"
            android:hint="password"
            android:inputType="textPassword"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            />

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/rgSignupGender"
            android:orientation="horizontal"
            android:layout_below="@id/edtSignupPassword"
            android:layout_marginStart="30dp"
            android:layout_marginTop="10dp"
            >

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/rbSignupGenderMale"
                    android:text="Male"
                    />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/rbSignupGenderFemale"
                android:text="Female"
                />

        </RadioGroup>


        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btnSignupSubmit"
            android:text="Submit"
            android:layout_below="@id/rgSignupGender"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            />

</RelativeLayout>