<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Semi-transparent vibrant green color (Hex ARGB: 50% opacity + Neon Green) -->
    <solid android:color="#8039FF14" />

    <!-- Large radius value ensures perfectly round caps (pill shape) -->
    <corners android:radius="200dp" />

    <!-- Adjust internal padding to look clean around the text -->
    <padding
        android:left="12dp"
        android:top="4dp"
        android:right="12dp"
        android:bottom="4dp" />
</shape>
